      "requirements": [
        {
          "id": "bdo_definition",
          "label": "definicja systemu BDO",
          "reason": "Treść musi poprawnie nazwać Bazę danych o produktach i opakowaniach oraz o gospodarce odpadami, Rejestr i moduły systemu.",
          "document_assertions": [
            {
              "id": "bdo_full_name",
              "label": "pełna nazwa BDO",
              "required_any_of": [
                "Baza danych o produktach i opakowaniach oraz o gospodarce odpadami"
              ]
            }
          ]
        },
        {
          "id": "bdo_registration_scope",
          "label": "kogo może dotyczyć wpis do BDO",
          "reason": "Treść musi uwzględniać działalność odpadową oraz wskazane przez urząd kategorie produktów, opakowań i innych wprowadzanych wyrobów.",
          "document_assertions": [
            {
              "id": "bdo_scope_products_or_packaging",
              "label": "kategorie produktów lub opakowań",
              "required_any_of": ["produkt", "opakowań", "opakowania"]
            },
            {
              "id": "bdo_scope_waste_activity",
              "label": "działalność związana z odpadami",
              "required_any_of": ["odpad"]
            }
          ]
        },
        {
          "id": "bdo_exemptions",
          "label": "wyłączenia z wpisu lub ewidencji",
